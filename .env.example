# cp .env.example .env  and fill in.  Never commit .env.
#
# Single source for everything except the runner's GitHub credentials, which
# live in runner/.env so CI secrets are never loaded into the DNS containers.

# --- Where persistent data lives -------------------------------------------
# MUST be an absolute path OUTSIDE this repo. If the database sits inside the
# working tree, `git clean -fdx` or a fresh clone destroys it.
DATA_ROOT=/srv/is-an-ai/data

# --- PostgreSQL / PowerDNS -------------------------------------------------
PDNS_DB_NAME=pdns
PDNS_DB_USER=
PDNS_DB_PASSWORD=
PDNS_API_KEY=

# --- gatus -----------------------------------------------------------------
GATUS_BASIC_USERNAME=
# bcrypt hash, base64-encoded. Generate with:
#   htpasswd -bnBC 12 "" 'yourpassword' | tr -d ':\n' | base64 -w0
# (macOS: base64 has no -w flag; drop it.)
GATUS_BASIC_PASSWORD_BCRYPT=
SLACK_WEBHOOK_URL=

# --- Optional --------------------------------------------------------------
TZ=Asia/Seoul
POSTGRES_IMAGE=postgres:17
GATUS_IMAGE=twinproduction/gatus:latest
BACKUP_INTERVAL=86400
BACKUP_KEEP=14
